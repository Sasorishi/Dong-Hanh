{% set sortedResetsPasswords = field.value|sort((a, b) => b.createdAt <=> a.createdAt) %}
{% if field.value is not empty %}
    <span>Total : {{ field.value|length }}</span>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Token</th>
                <th>Expired at</th>
                <th>Is expired</th>
                <th>Created at</th>
                <th>Updated at</th>
            </tr>
        </thead>
        <tbody>
        {% for item in sortedResetsPasswords %}
            <tr>
                <td>{{ item.id }}</td>
                <td>{{ item.token }}</td>
                <td>{{ item.expiredAt|date("m/d/Y H:i") }}</td>
                <td>{{ item.isExpired }}</td>
                <td>{{ item.createdAt|date("m/d/Y") }}</td>
                <td>{{ item.updatedAt|date("m/d/Y H:i") }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% else %}
    No items
{% endif %}