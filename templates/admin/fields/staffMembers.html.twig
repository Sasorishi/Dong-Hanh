{% set sortedStaffs = field.value|sort((a, b) => b.createdAt <=> a.createdAt) %}
{% if field.value is not empty %}
    <span>Total : {{ field.value|length }}</span>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Staff ID</th>
                <th>Firstname</th>
                <th>Lastname</th>
                <th>Gender</th>
                <th>Age</th>
                <th>Country</th>
                <th>Payment</th>
                <th>Created at</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for staff in sortedStaffs %}
            {% set staffDetailUrl = ea_url()
                .setController('App\\Controller\\Admin\\StaffCrudController')
                .setAction(constant('EasyCorp\\Bundle\\EasyAdminBundle\\Config\\Action::DETAIL'))
                .setEntityId(staff.id)
            %}
            <tr>
                <td>{{ staff.id }}</td>
                <td>{{ staff.firstname }}</td>
                <td>{{ staff.lastname }}</td>
                <td>{{ staff.gender }}</td>
                <td>{{ staff.age }}</td>
                <td>{{ staff.country }}</td>
                <td>{{ staff.payment ? 'yes' : 'no' }}</td>
                <td>{{ staff.createdAt|date("m/d/Y") }}</td>
                <td>
                    <a href="{{ staffDetailUrl }}">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="white" stroke-width="1.5" stroke="white" viewBox="0 0 512 512" width="18" height="18">
                            <path d="M256 512A256 256 0 1 0 256 0a256 256 0 1 0 0 512zM216 336h24V272H216c-13.3 0-24-10.7-24-24s10.7-24 24-24h48c13.3 0 24 10.7 24 24v88h8c13.3 0 24 10.7 24 24s-10.7 24-24 24H216c-13.3 0-24-10.7-24-24s10.7-24 24-24zm40-208a32 32 0 1 1 0 64 32 32 0 1 1 0-64z"/>
                        </svg>
                    </a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% else %}
    No staff members
{% endif %}